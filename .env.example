# Copy this file to `.env.local` (already git-ignored by the `*.local` rule)
# and fill in the values you need. Restart `npm run dev` after changing it.
# On Vercel/Netlify, add the same variable in the project's environment settings.

# Contact form endpoint. Any service that accepts a JSON POST works,
# for example a Formspree form: https://formspree.io/f/your-form-id
# Leave empty to disable sending. The form then falls back to opening the
# visitor's email app if an email address is set in src/data/site.js.
VITE_CONTACT_ENDPOINT=
